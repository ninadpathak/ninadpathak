# Standalone visuals exist to be embedded in articles. On their own they are thin
# pages, so keep them out of the index while letting Google index them as part of
# the article that embeds them. Do not Disallow them in robots.txt: Google has to
# crawl a visual to honour indexifembedded.
/static/visuals/*
  X-Robots-Tag: noindex, indexifembedded

# Article videos: WebVTT must be served as text/vtt or Firefox ignores the captions track.
/static/videos/:slug/captions.vtt
  Content-Type: text/vtt; charset=utf-8

# Markdown alternates of articles and hiring pages. Agents fetch them; search engines
# should index the HTML page, not its source.
/articles/:slug/index.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

/services/index.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

/services/:slug/index.md
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: noindex

# Keep preview deployments (<hash or branch>.<project>.pages.dev) out of the index. This
# is the form the Cloudflare Pages headers documentation gives (checked 2026-11-16):
# https://developers.cloudflare.com/pages/configuration/headers/
#
# The production alias <project>.pages.dev is left indexable on purpose. It holds
# rankings for hiring queries and canonicalises to ninadpathak.com; a noindex would drop
# those entries, where a 301 (a Cloudflare rule, not something this file can do) passes
# them on.
https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex
