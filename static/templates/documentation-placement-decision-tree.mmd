flowchart TB
    A["External reader needs<br/>this page?"]
    A -->|No| B["Operator needs it<br/>or it is private?"]
    A -->|Yes| C["Private operating<br/>context remains?"]
    B -->|Yes| D["Internal"]
    B -->|No| E["Review"]
    C -->|Yes| F["Split"]
    C -->|No| G["External"]

    classDef decision fill:#ffffff,stroke:#c8c8c4,stroke-width:2px,color:#0e0e0e,font-size:32px,font-weight:600;
    classDef outcome fill:#ffffff,stroke:#d44000,stroke-width:4px,color:#0e0e0e,font-size:32px,font-weight:600;
    class A,B,C decision;
    class D,E,F,G outcome;
    linkStyle default stroke:#c8c8c4,stroke-width:2px;
    linkStyle 0,1,2,3,4,5 color:#d44000,font-size:28px,font-weight:600;
