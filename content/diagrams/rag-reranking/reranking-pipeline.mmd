%% @glyph cross | pair
%% @glyph top5 | ranked rows=5 hi=0
%% @spacing 18,22
flowchart LR
  query["Query"]
  bi["Bi-encoder"]
  top100["Top 100"]
  cross["Cross-encoder"]:::accent
  top5["Top 5"]:::focal
  query --> bi --> top100 --> cross --> top5
