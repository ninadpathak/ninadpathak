%% @glyph cross | pair
%% @glyph score | ranked rows=1 hi=0
flowchart TB
  query["Query"]:::accent
  doc["Document"]
  cross["Cross-encoder"]:::focal
  score["Score"]
  query --> cross
  doc --> cross
  cross --> score
