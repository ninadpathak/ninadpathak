%% @fig 01
%% @kicker Append-only vs overwrite
%% @alt A memory changed in either of two ways. The append-only ledger inserts a new row and leaves the old ones in place, so v1, v2, and v3 all remain and any point in time can be recovered. A destructive update overwrites the row: v2 replaces v1, and the prior state is gone.
%% @caption Appending a new version and keeping the old ones lets the store answer for any past date.
%% @path v1>v2>v3
%% @glyph v1 | ledger rows=1
%% @glyph v2 | ledger rows=2
%% @glyph v3 | ledger rows=3
%% @glyph old | doc cross
%% @glyph gone | doc
flowchart TB
  subgraph append [Append-only]
    direction LR
    v1["v1"]
    v2["v2"]
    v3["v3"]:::focal
    v1 --> v2 --> v3
  end
  subgraph overwrite [Overwrite]
    direction LR
    old["v1"]:::fail
    gone["v2"]
    old --> gone
  end
  append ~~~ overwrite
