%% @glyph hist | ledger rows=4
%% @glyph ret | ranked rows=5 hi=1
%% @glyph pad | tokens
%% @glyph ctx | context
flowchart TB
  sys["System"]
  hist["History"]
  ret["Retrieved"]
  pad["Scratchpad"]
  ctx["Context window"]:::focal
  sys --> ctx
  hist --> ctx
  ret --> ctx
  pad --> ctx
