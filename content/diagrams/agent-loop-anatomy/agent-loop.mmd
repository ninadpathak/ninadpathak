%% @fig 01
%% @kicker The four-phase agent loop
%% @alt The agent loop runs perceive, think, act, and remember in sequence and returns to perceive until the task is complete or a stop condition ends the run. Infinite loops start in act; context exhaustion and lost tool results start in remember.
%% @caption Each phase has its own failure modes, so debug the loop one phase at a time.
%% @path perceive>think>act>remember>perceive
%% @note act | Infinite loops start here. Set an explicit iteration budget and test it.
%% @note remember | Context exhaustion and lost tool results start here, not in perceive.
%% @legend accent=Phase; outcome=Entry and exit; hot=One iteration
flowchart TB
  task(["Task arrives"]):::outcome
  subgraph loop [Agent loop · repeats until a stop condition]
    direction TB
    subgraph upper [ ]
      direction LR
      perceive["§01 Perceive
Read context
~Form the task state"]:::accent
      think["§02 Think
Reason over state
~Pick a tool and its arguments"]:::accent
    end
    subgraph lower [ ]
      direction RL
      act["§03 Act
Call the tool
~Produce output"]:::accent
      remember["§04 Remember
Update state
~Append the result, checkpoint"]:::accent
    end
  end
  done(["Done or stopped"]):::outcome
  task --> perceive
  perceive --> think
  think --> act
  act --> remember
  remember -->|next iteration| perceive
  remember -->|complete or stop| done
  class upper,lower ghost
