%% @glyph chained | tokens rows=5
%% @glyph nf2 | doc check
%% @glyph omega | loop
%% @glyph halt | stop
%% @spacing 16,36
flowchart LR
  direct["Direct"]
  nf1["Normal form"]
  chained["Chained"]
  nf2["Normal form"]
  omega["Ω"]:::accent
  halt["Detect"]:::focal
  direct --> nf1
  chained --> nf2
  omega --> halt
