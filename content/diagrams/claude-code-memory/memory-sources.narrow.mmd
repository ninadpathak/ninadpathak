%% @glyph claude | doc corner=person
%% @glyph auto | ledger rows=3
%% @glyph cli | inbox
%% @glyph session | context inside=5 w=74
%% @spacing 12,34
flowchart LR
  claude["CLAUDE.md"]
  auto["Auto<br/>memory"]
  cli["One-off"]:::muted
  session["Session"]:::focal
  claude --> session
  auto --> session
  cli -.-> session
