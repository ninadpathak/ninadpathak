%% @fig 01
%% @kicker What happens when context fills
%% @alt A new turn arrives in a full context window, and the memory layer has three moves: prioritize what a person asked to keep so those records stay, compress older records into a smaller summary, or evict the lowest-value records from memory entirely.
%% @caption Keeping what someone asked for, compressing older records and evicting the rest are separate policies.
%% @path turn>ctx>keep
%% @glyph turn | inbox
%% @glyph ctx | context
%% @glyph keep | ranked hi=0
%% @glyph squeeze | cells fill=0.35
%% @glyph evict | stop
%% @spacing 24,48
flowchart LR
  turn["New turn"]
  ctx["Context"]:::accent
  keep["Prioritize"]:::focal
  squeeze["Compress"]
  evict["Evict"]:::muted
  turn --> ctx
  ctx --> keep
  ctx --> squeeze
  ctx -.-> evict
