%% @width 288
%% @kicker Three kinds of load
%% @alt Three kinds of cognitive load share a reader's limited working memory. Intrinsic load is the difficulty of the task itself. Extraneous load is effort wasted on poor documentation design, marked as the load to remove. Germane load is the productive effort of building a mental model of the system, drawn as the path that should get the freed capacity.
%% @path germ>wm
%% @glyph intr | action w=44
%% @glyph extr | doc corner=cross w=44
%% @glyph germ | object w=44
%% @glyph wm | cells fill=0.85 w=44
%% @spacing 12,34
flowchart LR
  intr["Intrinsic"]
  extr["Extraneous"]:::muted
  germ["Germane"]:::accent
  wm["Working<br/>memory"]:::focal
  intr --> wm
  extr -.-> wm
  germ --> wm
