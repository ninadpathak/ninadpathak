%% @fig 01
%% @kicker Lost in the middle
%% @alt A long prompt split into its start, middle, and end. The model reliably recalls facts placed at the start, which frames the task, and at the end, which is the runway to the next token. Facts buried in the middle compete for whatever attention is left and often get skipped.
%% @caption Recall follows a U shape across the context. Put the instruction and the data you care about at the two ends.
%% @glyph start | tokens rows=5,5
%% @glyph middle | tokens rows=5,5
%% @glyph fin | tokens rows=5,5
%% @glyph model | core
flowchart TB
  subgraph prompt [Context]
    subgraph row [ ]
      direction LR
      start["Start"]:::accent
      middle["Middle"]:::muted
      fin["End"]:::accent
      start ~~~ middle ~~~ fin
    end
  end
  model["Model"]:::focal
  start --> model
  middle -.-> model
  fin --> model
  class row ghost
