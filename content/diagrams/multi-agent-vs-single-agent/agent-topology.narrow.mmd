%% @width 288
%% @kicker Single versus multi-agent
%% @alt A single agent runs one loop with one trace. A multi-agent system puts a supervisor over three workers, each with its own memory and failure boundary, so they can run independent work in parallel, but every handoff between them is a message boundary where things can break in transit.
%% @glyph single | loop
%% @glyph sup | loop
%% @glyph w1 | loop
%% @glyph w2 | loop
%% @glyph w3 | loop
%% @spacing 8,36
flowchart TB
  subgraph one [Single]
    single["Agent"]
  end
  subgraph many [Multi]
    direction LR
    sup["Supervisor"]:::accent
    w1["Worker"]
    w2["Worker"]
    w3["Worker"]
    sup --> w1
    sup --> w2
    sup --> w3
  end
  one ~~~ many
