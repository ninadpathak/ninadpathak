%% @glyph app | window
%% @glyph pglite | store
%% @glyph sqlite | plug
%% @spacing 48,48
flowchart TB
  app["Relational data?"]:::accent
  pglite["PGlite"]:::focal
  sqlite["SQLite-vec"]
  app -->|yes| pglite
  app -->|no| sqlite
