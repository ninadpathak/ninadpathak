%% @fig 01
%% @kicker Documentation placement
%% @alt Documentation placement decision tree. If no external reader needs the information, keep it internal when an operator needs it or it holds private context; otherwise review whether the page has a task. If an external reader needs it, split it into a public task page and a private record when private context remains; otherwise publish it externally.
%% @caption Each path ends in internal, review, split, or external documentation. A split is two documents with one contract between them, not a redacted internal page.
%% @path reader>public>split
%% @glyph reader | reader globe
%% @glyph private | reader lock
%% @glyph public | doc lock
%% @glyph internal | doc lock
%% @glyph review | doc question
%% @glyph split | pair
%% @glyph external | doc globe
%% @dim internal | review | :lock
%% @dim split | external | :globe
flowchart TB
  reader["Outside reader?"]:::accent
  private["Operator need?"]
  public["Private context?"]:::accent
  internal["Internal"]
  review["Review"]
  split["Split"]:::focal
  external["External"]
  reader -->|no| private
  reader -->|yes| public
  private -->|yes| internal
  private -->|no| review
  public -->|yes| split
  public -->|no| external
