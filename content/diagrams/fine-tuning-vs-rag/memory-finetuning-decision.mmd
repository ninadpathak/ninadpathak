%% @fig 01
%% @kicker Fine-tuning or RAG
%% @alt A decision tree. If the knowledge changes frequently, use RAG. If it doesn't, ask whether the problem is behavioral, meaning how the model reasons: a behavioral problem means fine-tuning, and a factual problem means RAG.
%% @caption Most production systems end up with both: RAG carries the facts, and fine-tuning adds the reasoning patterns retrieval can't teach.
%% @path change>rag
%% @glyph change | doc question
%% @glyph behave | reader question
%% @glyph rag | vectors
%% @glyph ft | core
%% @glyph rag2 | vectors
flowchart TB
  change["Facts change?"]:::accent
  rag["RAG"]:::focal
  behave["Behavior issue?"]
  ft["Fine-tune"]
  rag2["RAG"]
  change -->|yes| rag
  change -->|no| behave
  behave -->|yes| ft
  behave -->|no| rag2
