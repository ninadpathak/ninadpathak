%% @width 288
%% @kicker Harness layers
%% @alt The agent harness sits between the application and the model. Its five components are the execution loop, the tool registry the loop calls in both directions, the prompt assembler that builds the prompt the model receives, the state manager that holds checkpoints, and the observer that logs every step. The model only reasons.
%% @path app>loop>prompt>llm
%% @glyph app | window
%% @glyph loop | loop w=44
%% @glyph prompt | tokens w=44
%% @glyph state | cells fill=0.55 flag w=44
%% @glyph observer | eye w=44
%% @glyph llm | core
%% @glyph tools | tools w=44
%% @spacing 4,34
flowchart TB
  app["App"]:::external
  subgraph harness [Harness]
    direction TB
    subgraph r1 [ ]
      direction LR
      tools["Tools"]:::stack
      loop["Loop"]:::accent
    end
    subgraph r2 [ ]
      direction LR
      state["State"]
      observer["Observer"]
    end
    prompt["Prompt"]:::accent
  end
  llm["Model"]:::focal
  app --> loop
  tools <--> loop
  loop --> state
  loop -.-> observer
  loop --> prompt
  prompt --> llm
  state ~~~ prompt
  class r1,r2 ghost
