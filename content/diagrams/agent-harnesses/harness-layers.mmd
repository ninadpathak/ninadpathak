%% @fig 01
%% @kicker Harness layers around the raw LLM
%% @alt The agent harness sits between the application and the model. Its five components are the execution loop, the tool registry the loop calls in both directions, the prompt assembler that builds the prompt the model receives, the state manager that holds checkpoints, and the observer that logs every step. The model only reasons.
%% @caption The model reasons. The harness handles everything else, including the checkpoint that lets an interrupted run resume.
%% @path app>loop>prompt>llm
%% @glyph app | window
%% @glyph loop | loop
%% @glyph prompt | tokens
%% @glyph state | cells fill=0.55 flag
%% @glyph observer | eye
%% @glyph llm | core
%% @glyph tools | tools
%% @spacing 40,72
flowchart TB
  app["App"]:::external
  subgraph harness [Harness]
    direction TB
    subgraph row1 [ ]
      direction LR
      tools["Tools"]:::stack
      loop["Loop"]:::accent
    end
    state["State"]
    prompt["Prompt"]:::accent
    observer["Observer"]
  end
  llm["Model"]:::focal
  app --> loop
  tools <--> loop
  loop --> state
  loop --> prompt
  loop -.-> observer
  prompt --> llm
  class row1 ghost
