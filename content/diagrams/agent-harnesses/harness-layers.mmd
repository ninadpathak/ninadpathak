%% @fig 01
%% @kicker Harness layers around the raw LLM
%% @alt The agent harness sits between the application and the model. Inside it, the execution loop calls tools in both directions, checkpoints state, and logs every step to an observer, and the prompt assembler builds the prompt the model receives. The model only reasons.
%% @caption The model reasons. The harness handles everything else, including the checkpoint that lets an interrupted run resume.
%% @path app>loop>prompt>llm
%% @glyph app | window
%% @glyph loop | loop
%% @glyph prompt | tokens
%% @glyph state | cells fill=0.55 flag
%% @glyph observer | eye
%% @glyph llm | core
%% @glyph tools | tools
flowchart TB
  app["App"]:::external
  subgraph harness [Harness]
    direction LR
    loop["Loop"]:::accent
    prompt["Prompt"]:::accent
    state["State"]
    observer["Observer"]
  end
  llm["Model"]:::focal
  tools["Tools"]:::stack
  app --> loop
  loop --> prompt
  prompt --> llm
  loop <--> tools
  loop --> state
  loop -.-> observer
