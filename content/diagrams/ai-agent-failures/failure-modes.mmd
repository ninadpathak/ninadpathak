%% @ring perceive>think>act>remember | 116 | 56
%% @glyph perceive | eye corner=cross
%% @glyph think | core
%% @glyph act | tools corner=cross
%% @glyph remember | cells fill=0.6
%% @glyph twice | tools
%% @glyph polluted | context
flowchart LR
  perceive["Perceive"]:::fail
  think["Think"]:::accent
  act["Act"]:::fail
  remember["Remember"]:::accent
  twice["Runs twice"]:::stack
  polluted["Polluted context"]
  perceive --> think
  think --> act
  act --> remember
  remember --> perceive
  act -.-> twice
  polluted -.-> perceive
